  "semanticTokenColors": {
    "namespace": "#CCFF00",
    "class": {
      "foreground": "#CCFF00",
      "bold": true
    },
    "interface": {
      "foreground": "#CCFF00",
      "italic": true
    },
    "enum": "#CCFF00",
    "enumMember": "#FFB800",
    "type": {
      "foreground": "#CCFF00",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#00E5A3",
      "italic": true
    },
    "function": {
      "foreground": "#39FF14",
      "bold": true
    },
    "function.async": {
      "foreground": "#39FF14",
      "bold": true,
      "italic": true
    },
    "method": {
      "foreground": "#39FF14",
      "bold": true
    },
    "method.async": {
      "foreground": "#39FF14",
      "bold": true,
      "italic": true
    },
    "macro": {
      "foreground": "#00E5A3",
      "bold": true
    },
    "variable": "#ECFEF4",
    "variable.readonly": "#FFB800",
    "variable.defaultLibrary": {
      "foreground": "#CCFF00",
      "italic": true
    },
    "parameter": {
      "foreground": "#7BA88E",
      "italic": true
    },
    "property": "#ECFEF4",
    "property.readonly": "#FFB800",
    "keyword": {
      "foreground": "#00E5A3",
      "italic": true
    },
    "modifier": {
      "foreground": "#00E5A3",
      "italic": true
    },
    "operator": "#39FF14",
    "comment": {
      "foreground": "#3B5947",
      "italic": true
    },
    "string": "#6EE7B7",
    "number": "#FFB800",
    "regexp": "#00E5A3",
    "decorator": {
      "foreground": "#10B981",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Tier 4 \u2014 Recessed Context: Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#3B5947",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 4 \u2014 Structural Punctuation (Dimmed to reduce eye noise)",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#7BA88E"
      }
    },
    {
      "name": "Tier 1 \u2014 Execution Hotspots: Function & Method Declarations/Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#39FF14",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 1 \u2014 Control Flow & Keywords (High-Velocity Italic)",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#00E5A3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 1 \u2014 Operators & Assignment Arrows",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#39FF14"
      }
    },
    {
      "name": "Tier 2 \u2014 Architecture & Types: Classes, Interfaces, Generics",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#CCFF00",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 2 \u2014 Data Payloads: Strings & Template Literals",
      "scope": [
        "string",
        "constant.other.symbol",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#6EE7B7"
      }
    },
    {
      "name": "Tier 2 \u2014 String Interpolation Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#39FF14",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 2 \u2014 Immutable Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FFB800"
      }
    },
    {
      "name": "Tier 3 \u2014 Variables & Identifiers (Pure High-Contrast Legibility)",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#ECFEF4"
      }
    },
    {
      "name": "Tier 3 \u2014 Function Parameters & Arguments",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#7BA88E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 3 \u2014 Object Keys & Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#ECFEF4"
      }
    },
    {
      "name": "Tier 2 \u2014 JSX / HTML / XML Tags & Components",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#10B981"
      }
    },
    {
      "name": "Tier 2 \u2014 JSX / HTML Attributes & Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#CCFF00",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / This / Super Reference Keywords",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#00E5A3",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown Headings & Documentation Architecture",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#39FF14",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#00E5A3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#6EE7B7"
      }
    },
    {
      "name": "Invalid & Deprecated Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF3366",
        "fontStyle": "underline"
      }
    }
  ]
}