  "semanticTokenColors": {
    "namespace": "#A855F7",
    "class": {
      "foreground": "#A855F7",
      "bold": true
    },
    "interface": {
      "foreground": "#A855F7",
      "italic": true
    },
    "enum": "#A855F7",
    "enumMember": "#F43F5E",
    "type": {
      "foreground": "#A855F7",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#3B82F6",
      "italic": true
    },
    "function": {
      "foreground": "#00F0FF",
      "bold": true
    },
    "function.async": {
      "foreground": "#00F0FF",
      "bold": true,
      "italic": true
    },
    "method": {
      "foreground": "#00F0FF",
      "bold": true
    },
    "method.async": {
      "foreground": "#00F0FF",
      "bold": true,
      "italic": true
    },
    "macro": {
      "foreground": "#3B82F6",
      "bold": true
    },
    "variable": "#EDF5FF",
    "variable.readonly": "#F43F5E",
    "variable.defaultLibrary": {
      "foreground": "#A855F7",
      "italic": true
    },
    "parameter": {
      "foreground": "#7A93B8",
      "italic": true
    },
    "property": "#EDF5FF",
    "property.readonly": "#F43F5E",
    "keyword": {
      "foreground": "#3B82F6",
      "italic": true
    },
    "modifier": {
      "foreground": "#3B82F6",
      "italic": true
    },
    "operator": "#00F0FF",
    "comment": {
      "foreground": "#3B4D6B",
      "italic": true
    },
    "string": "#67E8F9",
    "number": "#F43F5E",
    "regexp": "#3B82F6",
    "decorator": {
      "foreground": "#38BDF8",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Tier 4 \u2014 Recessed Context: Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#3B4D6B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 4 \u2014 Structural Punctuation (Dimmed to reduce eye noise)",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#7A93B8"
      }
    },
    {
      "name": "Tier 1 \u2014 Execution Hotspots: Function & Method Declarations/Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#00F0FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 1 \u2014 Control Flow & Keywords (High-Velocity Italic)",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#3B82F6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 1 \u2014 Operators & Assignment Arrows",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#00F0FF"
      }
    },
    {
      "name": "Tier 2 \u2014 Architecture & Types: Classes, Interfaces, Generics",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#A855F7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 2 \u2014 Data Payloads: Strings & Template Literals",
      "scope": [
        "string",
        "constant.other.symbol",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#67E8F9"
      }
    },
    {
      "name": "Tier 2 \u2014 String Interpolation Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#00F0FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 2 \u2014 Immutable Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F43F5E"
      }
    },
    {
      "name": "Tier 3 \u2014 Variables & Identifiers (Pure High-Contrast Legibility)",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#EDF5FF"
      }
    },
    {
      "name": "Tier 3 \u2014 Function Parameters & Arguments",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#7A93B8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 3 \u2014 Object Keys & Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#EDF5FF"
      }
    },
    {
      "name": "Tier 2 \u2014 JSX / HTML / XML Tags & Components",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Tier 2 \u2014 JSX / HTML Attributes & Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#A855F7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / This / Super Reference Keywords",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#3B82F6",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown Headings & Documentation Architecture",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#00F0FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#3B82F6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#67E8F9"
      }
    },
    {
      "name": "Invalid & Deprecated Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EF4444",
        "fontStyle": "underline"
      }
    }
  ]
}