    "editorInlayHint.parameterForeground": "#8A8C8E",
    "editorGhostText.foreground": "#6C6E70",

    "editorStickyScroll.background": "#101112",
    "editorStickyScrollHover.background": "#181A1C",

    "editorWidget.background": "#181A1C",
    "editorWidget.foreground": "#E7E7E4",
    "editorWidget.border": "#2A2D31",
    "editorSuggestWidget.background": "#181A1C",
    "editorSuggestWidget.border": "#2A2D31",
    "editorSuggestWidget.foreground": "#E7E7E4",
    "editorSuggestWidget.highlightForeground": "#D6A66B",
    "editorSuggestWidget.selectedBackground": "#24272B",
    "editorHoverWidget.background": "#181A1C",
    "editorHoverWidget.border": "#2A2D31",

    "peekView.border": "#2A2D31",
    "peekViewEditor.background": "#141517",
    "peekViewEditor.matchHighlightBackground": "#E5A95C33",
    "peekViewResult.background": "#0B0C0D",
    "peekViewTitle.background": "#181A1C",
    "peekViewTitleLabel.foreground": "#E7E7E4",

    "diffEditor.insertedTextBackground": "#A9C5AE18",
    "diffEditor.removedTextBackground": "#E07A7518",
    "editorGutter.modifiedBackground": "#D6A66B",
    "editorGutter.addedBackground": "#A9C5AE",
    "editorGutter.deletedBackground": "#E07A75",

    "gitDecoration.addedResourceForeground": "#A9C5AE",
    "gitDecoration.modifiedResourceForeground": "#D6A66B",
    "gitDecoration.deletedResourceForeground": "#E07A75",
    "gitDecoration.untrackedResourceForeground": "#9BB6CC",
    "gitDecoration.ignoredResourceForeground": "#636567",
    "gitDecoration.conflictingResourceForeground": "#D4886A",

    "panel.background": "#0B0C0D",
    "panel.border": "#181A1C",
    "panelTitle.activeBorder": "#D6A66B",
    "panelTitle.activeForeground": "#E7E7E4",
    "panelTitle.inactiveForeground": "#7C7E80",

    "terminal.background": "#0B0C0D",
    "terminal.foreground": "#E7E7E4",
    "terminalCursor.foreground": "#D6A66B",
    "terminal.selectionBackground": "#FFFFFF26",
    "terminal.ansiBlack": "#181A1C",
    "terminal.ansiRed": "#E07A75",
    "terminal.ansiGreen": "#A9C5AE",
    "terminal.ansiYellow": "#E6C690",
    "terminal.ansiBlue": "#9BB6CC",
    "terminal.ansiMagenta": "#D49A9A",
    "terminal.ansiCyan": "#9BC4BC",
    "terminal.ansiWhite": "#E7E7E4",
    "terminal.ansiBrightBlack": "#7C7E80",
    "terminal.ansiBrightRed": "#F0948F",
    "terminal.ansiBrightGreen": "#C1DEC6",
    "terminal.ansiBrightYellow": "#F3D9AB",
    "terminal.ansiBrightBlue": "#B5CEE0",
    "terminal.ansiBrightMagenta": "#E5B5B5",
    "terminal.ansiBrightCyan": "#B5DBD3",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "statusBar.background": "#0B0C0D",
    "statusBar.foreground": "#96989A",
    "statusBar.border": "#181A1C",
    "statusBar.debuggingBackground": "#D4886A",
    "statusBar.debuggingForeground": "#101112",
    "statusBar.noFolderBackground": "#0B0C0D",
    "statusBarItem.remoteBackground": "#D6A66B",
    "statusBarItem.remoteForeground": "#101112",
    "statusBarItem.hoverBackground": "#1E2023",

    "titleBar.activeBackground": "#0B0C0D",
    "titleBar.activeForeground": "#96989A",
    "titleBar.inactiveBackground": "#0B0C0D",
    "titleBar.inactiveForeground": "#636567",
    "titleBar.border": "#0B0C0D",

    "commandCenter.foreground": "#96989A",
    "commandCenter.activeForeground": "#E7E7E4",
    "commandCenter.background": "#16181A",
    "commandCenter.activeBackground": "#1E2023",
    "commandCenter.border": "#24272B",

    "breadcrumb.background": "#101112",
    "breadcrumb.foreground": "#7C7E80",
    "breadcrumb.focusForeground": "#E7E7E4",
    "breadcrumb.activeSelectionForeground": "#D6A66B",
    "breadcrumbPicker.background": "#181A1C"
  },
  "semanticTokenColors": {
    "namespace": "#9BB6CC",
    "class": {
      "foreground": "#9BB6CC",
      "bold": true
    },
    "interface": {
      "foreground": "#9BB6CC",
      "italic": true
    },
    "enum": "#9BB6CC",
    "enumMember": "#DFB47E",
    "type": {
      "foreground": "#9BB6CC",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#B5CEE0",
      "italic": true
    },
    "function": {
      "foreground": "#E6C690",
      "bold": true
    },
    "function.async": {
      "foreground": "#E6C690",
      "bold": true,
      "italic": true
    },
    "method": {
      "foreground": "#E6C690",
      "bold": true
    },
    "method.async": {
      "foreground": "#E6C690",
      "bold": true,
      "italic": true
    },
    "macro": {
      "foreground": "#D4886A",
      "bold": true
    },
    "variable": "#E7E7E4",
    "variable.readonly": "#DFB47E",
    "variable.defaultLibrary": {
      "foreground": "#9BB6CC",
      "italic": true
    },
    "parameter": {
      "foreground": "#D49A9A",
      "italic": true
    },
    "property": "#D8D9D6",
    "property.readonly": "#DFB47E",
    "keyword": {
      "foreground": "#D4886A",
      "italic": true
    },
    "modifier": {
      "foreground": "#D4886A",
      "italic": true
    },
    "operator": "#D6A66B",
    "comment": {
      "foreground": "#6E7072",
      "italic": true
    },
    "string": "#A9C5AE",
    "number": "#DFB47E",
    "regexp": "#D49A9A",
    "decorator": {
      "foreground": "#D4886A",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Tier 4 — Recessed Context: Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6E7072",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 4 — Structural Punctuation (Dimmed to reduce eye noise)",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8B8E90"
      }
    },
    {
      "name": "Tier 1 — Execution Hotspots: Function & Method Declarations/Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#E6C690",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 1 — Control Flow & Keywords (High-Velocity Italic)",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#D4886A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 1 — Operators & Assignment Arrows",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#D6A66B"
      }
    },
    {
      "name": "Tier 2 — Architecture & Types: Classes, Interfaces, Generics",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#9BB6CC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 2 — Data Payloads: Strings & Template Literals",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#A9C5AE"
      }
    },
    {
      "name": "Tier 2 — Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#D49A9A"
      }
    },
    {
      "name": "Tier 2 — String Interpolation Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#D6A66B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 2 — Immutable Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#DFB47E"
      }
    },
    {
      "name": "Tier 3 — Variables & Identifiers (Pure High-Contrast Legibility)",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E7E7E4"
      }
    },
    {
      "name": "Tier 3 — Function Parameters & Arguments",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#D49A9A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 3 — Object Keys & Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D8D9D6"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML / XML Tags & Components",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#9BB6CC"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML Attributes & Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#D49A9A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / This / Super Reference Keywords",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#D4886A",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown Headings & Documentation Architecture",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#E6C690",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D4886A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#A9C5AE"
      }
    },
    {
      "name": "Invalid & Deprecated Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E07A75",
        "fontStyle": "underline"
      }
    }
  ]
}
