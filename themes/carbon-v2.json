    "editorLineNumber.activeForeground": "#D6A66B",
    "editorCursor.background": "#101112",
    "editorCursor.foreground": "#D6A66B",

    "editor.selectionBackground": "#FFFFFF22",
    "editor.inactiveSelectionBackground": "#FFFFFF14",
    "editor.selectionHighlightBackground": "#D6A66B1A",
    "editor.selectionHighlightBorder": "#D6A66B44",
    "editor.wordHighlightBackground": "#9BB6CC1F",
    "editor.wordHighlightStrongBackground": "#9BB6CC33",
    "editor.findMatchBackground": "#E5A95C38",
    "editor.findMatchHighlightBackground": "#E5A95C1F",
    "editor.findMatchBorder": "#E5A95C",
    "editor.hoverHighlightBackground": "#1E2023",
    "editor.lineHighlightBackground": "#181A1CAA",
    "editor.lineHighlightBorder": "#00000000",

    "editorLink.activeForeground": "#9BB6CC",
    "editorWhitespace.foreground": "#2A2D31",
    "editorIndentGuide.background1": "#1E2023",
    "editorIndentGuide.activeBackground1": "#4E5258",
    "editorRuler.foreground": "#1E2023",
    "editorCodeLens.foreground": "#7C7E80",

    "editorBracketMatch.background": "#D6A66B26",
    "editorBracketMatch.border": "#D6A66B88",
    "editorBracketHighlight.foreground1": "#E6C690",
    "editorBracketHighlight.foreground2": "#9BB6CC",
    "editorBracketHighlight.foreground3": "#D49A9A",
    "editorBracketHighlight.foreground4": "#A9C5AE",
    "editorBracketHighlight.foreground5": "#D4886A",
