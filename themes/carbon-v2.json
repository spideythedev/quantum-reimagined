    "panelTitle.inactiveForeground": "#4A4A52",
    "terminal.background": "#050505",
    "terminal.foreground": "#EDEDEF",
    "terminalCursor.foreground": "#FFFFFF",
    "terminal.selectionBackground": "#FFFFFF33",
    "terminal.ansiBlack": "#111113",
    "terminal.ansiRed": "#EF4444",
    "terminal.ansiGreen": "#22C55E",
    "terminal.ansiYellow": "#EAB308",
    "terminal.ansiBlue": "#FF6B00",
    "terminal.ansiMagenta": "#60A5FA",
    "terminal.ansiCyan": "#FFFFFF",
    "terminal.ansiWhite": "#EDEDEF",
    "terminal.ansiBrightBlack": "#4A4A52",
    "terminal.ansiBrightRed": "#EF4444",
    "terminal.ansiBrightGreen": "#22C55E",
    "terminal.ansiBrightYellow": "#34D399",
    "terminal.ansiBrightBlue": "#A1A1AA",
    "terminal.ansiBrightMagenta": "#FF6B00",
    "terminal.ansiBrightCyan": "#FFFFFF",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "statusBar.background": "#050505",
    "statusBar.foreground": "#8E8E96",
    "statusBar.border": "#2A2A3066",
    "statusBar.debuggingBackground": "#FF6B00",
    "statusBar.debuggingForeground": "#050505",
    "statusBar.noFolderBackground": "#050505",
    "statusBarItem.remoteBackground": "#FFFFFF",
    "statusBarItem.remoteForeground": "#050505",
    "statusBarItem.hoverBackground": "#1A1A1E",
    "titleBar.activeBackground": "#050505",
    "titleBar.activeForeground": "#EDEDEF",
    "titleBar.inactiveBackground": "#050505",
    "titleBar.inactiveForeground": "#4A4A52",
