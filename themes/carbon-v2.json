    "breadcrumb.background": "#0A0A0B",
    "breadcrumb.foreground": "#999A99",
    "breadcrumb.focusForeground": "#D6A66B",
    "breadcrumb.activeSelectionForeground": "#D6A66B",
    "breadcrumbPicker.background": "#111113"
