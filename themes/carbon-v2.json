    "breadcrumb.background": "#0A0A0B",
    "breadcrumb.foreground": "#4A4A52",
    "breadcrumb.focusForeground": "#EDEDEF",
    "breadcrumb.activeSelectionForeground": "#FFFFFF",
    "breadcrumbPicker.background": "#111113"
