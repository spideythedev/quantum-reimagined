    "titleBar.activeBackground": "#060B08",
    "titleBar.activeForeground": "#8BA092",
    "titleBar.inactiveBackground": "#060B08",
    "titleBar.inactiveForeground": "#54695B",
    "titleBar.border": "#060B08",

    "commandCenter.foreground": "#8BA092",
    "commandCenter.activeForeground": "#E6F0E8",
