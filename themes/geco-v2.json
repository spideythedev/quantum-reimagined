    "terminal.background": "#060B08",
    "terminal.foreground": "#E6F0E8",
    "terminalCursor.foreground": "#5CE645",
    "terminal.selectionBackground": "#39FF142E",
    "terminal.ansiBlack": "#121E17",
    "terminal.ansiRed": "#E88276",
    "terminal.ansiGreen": "#7EE89C",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#7CB8D4",
    "terminal.ansiMagenta": "#C99CE0",
    "terminal.ansiCyan": "#6CD4C4",
    "terminal.ansiWhite": "#E6F0E8",
    "terminal.ansiBrightBlack": "#6E8576",
    "terminal.ansiBrightRed": "#F59C90",
    "terminal.ansiBrightGreen": "#9FF5B8",
    "terminal.ansiBrightYellow": "#F2D49B",
    "terminal.ansiBrightBlue": "#9AD0E8",
    "terminal.ansiBrightMagenta": "#DCB8F0",
    "terminal.ansiBrightCyan": "#92E6D9",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "statusBar.background": "#060B08",
    "statusBar.foreground": "#8BA092",
    "statusBar.border": "#121E17",
    "statusBar.debuggingBackground": "#39FF14",
    "statusBar.debuggingForeground": "#060B08",
    "statusBar.noFolderBackground": "#060B08",
    "statusBarItem.remoteBackground": "#A9C878",
    "statusBarItem.remoteForeground": "#060B08",
