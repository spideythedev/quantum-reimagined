    "breadcrumb.background": "#0A120E",
    "breadcrumb.foreground": "#6E8576",
    "breadcrumb.focusForeground": "#E6F0E8",
    "breadcrumb.activeSelectionForeground": "#5CE645",
    "breadcrumbPicker.background": "#121E17"
