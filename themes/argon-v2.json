    "editorInlayHint.typeForeground": "#73D2DECC",
    "editorInlayHint.parameterForeground": "#8C7F9C",
    "editorGhostText.foreground": "#6E627C",

    "editorStickyScroll.background": "#100D18",
    "editorStickyScrollHover.background": "#181324",

    "editorWidget.background": "#181324",
    "editorWidget.foreground": "#EEE8F5",
    "editorWidget.border": "#2A223E",
    "editorSuggestWidget.background": "#181324",
    "editorSuggestWidget.border": "#2A223E",
    "editorSuggestWidget.foreground": "#EEE8F5",
    "editorSuggestWidget.highlightForeground": "#DF73FF",
    "editorSuggestWidget.selectedBackground": "#251E38",
    "editorHoverWidget.background": "#181324",
    "editorHoverWidget.border": "#2A223E",

    "peekView.border": "#2A223E",
    "peekViewEditor.background": "#14101F",
    "peekViewEditor.matchHighlightBackground": "#E5C07B33",
    "peekViewResult.background": "#0C0912",
    "peekViewTitle.background": "#181324",
    "peekViewTitleLabel.foreground": "#EEE8F5",

    "diffEditor.insertedTextBackground": "#7CE3B318",
    "diffEditor.removedTextBackground": "#F0718818",
    "editorGutter.modifiedBackground": "#B8A1FF",
    "editorGutter.addedBackground": "#7CE3B3",
    "editorGutter.deletedBackground": "#F07188",

    "gitDecoration.addedResourceForeground": "#7CE3B3",
    "gitDecoration.modifiedResourceForeground": "#B8A1FF",
    "gitDecoration.deletedResourceForeground": "#F07188",
    "gitDecoration.untrackedResourceForeground": "#73D2DE",
    "gitDecoration.ignoredResourceForeground": "#635870",
    "gitDecoration.conflictingResourceForeground": "#F2B880",

    "panel.background": "#0C0912",
    "panel.border": "#181324",
    "panelTitle.activeBorder": "#DF73FF",
    "panelTitle.activeForeground": "#EEE8F5",
    "panelTitle.inactiveForeground": "#7E728C",

    "terminal.background": "#0C0912",
    "terminal.foreground": "#EEE8F5",
    "terminalCursor.foreground": "#DF73FF",
    "terminal.selectionBackground": "#D946EF33",
    "terminal.ansiBlack": "#181324",
    "terminal.ansiRed": "#F07188",
    "terminal.ansiGreen": "#7CE3B3",
    "terminal.ansiYellow": "#F3C98B",
    "terminal.ansiBlue": "#73D2DE",
    "terminal.ansiMagenta": "#DF73FF",
    "terminal.ansiCyan": "#9EE0C2",
    "terminal.ansiWhite": "#EEE8F5",
    "terminal.ansiBrightBlack": "#7E728C",
    "terminal.ansiBrightRed": "#FF8DA1",
    "terminal.ansiBrightGreen": "#9BF0C8",
    "terminal.ansiBrightYellow": "#FAD9A6",
    "terminal.ansiBrightBlue": "#94E2ED",
    "terminal.ansiBrightMagenta": "#EA9EFF",
    "terminal.ansiBrightCyan": "#BCEEE0",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "statusBar.background": "#0C0912",
    "statusBar.foreground": "#9A8DA8",
    "statusBar.border": "#181324",
    "statusBar.debuggingBackground": "#D946EF",
    "statusBar.debuggingForeground": "#100D18",
    "statusBar.noFolderBackground": "#0C0912",
    "statusBarItem.remoteBackground": "#B69AD8",
    "statusBarItem.remoteForeground": "#100D18",
    "statusBarItem.hoverBackground": "#1E182D",

    "titleBar.activeBackground": "#0C0912",
    "titleBar.activeForeground": "#9A8DA8",
    "titleBar.inactiveBackground": "#0C0912",
    "titleBar.inactiveForeground": "#635870",
    "titleBar.border": "#0C0912",

    "commandCenter.foreground": "#9A8DA8",
    "commandCenter.activeForeground": "#EEE8F5",
    "commandCenter.background": "#161221",
    "commandCenter.activeBackground": "#1E182D",
    "commandCenter.border": "#241D36",

    "breadcrumb.background": "#100D18",
    "breadcrumb.foreground": "#7E728C",
    "breadcrumb.focusForeground": "#EEE8F5",
    "breadcrumb.activeSelectionForeground": "#DF73FF",
    "breadcrumbPicker.background": "#181324"
  },
  "semanticTokenColors": {
    "namespace": "#73D2DE",
    "class": {
      "foreground": "#73D2DE",
      "bold": true
    },
    "interface": {
      "foreground": "#73D2DE",
      "italic": true
    },
    "enum": "#73D2DE",
    "enumMember": "#F2B880",
    "type": {
      "foreground": "#73D2DE",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#94E2ED",
      "italic": true
    },
    "function": {
      "foreground": "#B8A1FF",
      "bold": true
    },
    "function.async": {
      "foreground": "#B8A1FF",
      "bold": true,
      "italic": true
    },
    "method": {
      "foreground": "#B8A1FF",
      "bold": true
    },
    "method.async": {
      "foreground": "#B8A1FF",
      "bold": true,
      "italic": true
    },
    "macro": {
      "foreground": "#DF73FF",
      "bold": true
    },
    "variable": "#EEE8F5",
    "variable.readonly": "#F2B880",
    "variable.defaultLibrary": {
      "foreground": "#73D2DE",
      "italic": true
    },
    "parameter": {
      "foreground": "#F0A899",
      "italic": true
    },
    "property": "#DDD4E8",
    "property.readonly": "#F2B880",
    "keyword": {
      "foreground": "#DF73FF",
      "italic": true
    },
    "modifier": {
      "foreground": "#DF73FF",
      "italic": true
    },
    "operator": "#B69AD8",
    "comment": {
      "foreground": "#6E627C",
      "italic": true
    },
    "string": "#9EE0C2",
    "number": "#F2B880",
    "regexp": "#F0A899",
    "decorator": {
      "foreground": "#DF73FF",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Tier 4 — Recessed Context: Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6E627C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 4 — Structural Punctuation (Dimmed to reduce eye noise)",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8B7E9C"
      }
    },
    {
      "name": "Tier 1 — Execution Hotspots: Function & Method Declarations/Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#B8A1FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 1 — Control Flow & Keywords (High-Velocity Italic)",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#DF73FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 1 — Operators & Assignment Arrows",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#B69AD8"
      }
    },
    {
      "name": "Tier 2 — Architecture & Types: Classes, Interfaces, Generics",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#73D2DE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 2 — Data Payloads: Strings & Template Literals",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#9EE0C2"
      }
    },
    {
      "name": "Tier 2 — Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#F0A899"
      }
    },
    {
      "name": "Tier 2 — String Interpolation Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#DF73FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 2 — Immutable Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F2B880"
      }
    },
    {
      "name": "Tier 3 — Variables & Identifiers (Pure High-Contrast Legibility)",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#EEE8F5"
      }
    },
    {
      "name": "Tier 3 — Function Parameters & Arguments",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#F0A899",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 3 — Object Keys & Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#DDD4E8"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML / XML Tags & Components",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#73D2DE"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML Attributes & Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#F0A899",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / This / Super Reference Keywords",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#DF73FF",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown Headings & Documentation Architecture",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#B8A1FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DF73FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#9EE0C2"
      }
    },
    {
      "name": "Invalid & Deprecated Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F07188",
        "fontStyle": "underline"
      }
    }
  ]
}
