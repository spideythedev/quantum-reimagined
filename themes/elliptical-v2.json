  "semanticTokenColors": {
    "namespace": "#C79BF2",
    "class": {
      "foreground": "#C79BF2",
      "bold": true
    },
    "interface": {
      "foreground": "#C79BF2",
      "italic": true
    },
    "enum": "#C79BF2",
    "enumMember": "#E0B684",
    "type": {
      "foreground": "#C79BF2",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#DAB8FA",
      "italic": true
    },
    "function": {
      "foreground": "#AEB3F0",
      "bold": true
    },
    "function.async": {
      "foreground": "#AEB3F0",
      "bold": true,
      "italic": true
    },
    "method": {
      "foreground": "#AEB3F0",
      "bold": true
    },
    "method.async": {
      "foreground": "#AEB3F0",
      "bold": true,
      "italic": true
    },
    "macro": {
      "foreground": "#7AD1C9",
      "bold": true
    },
    "variable": "#E9EAF7",
    "variable.readonly": "#E0B684",
    "variable.defaultLibrary": {
      "foreground": "#C79BF2",
      "italic": true
    },
    "parameter": {
      "foreground": "#EDA398",
      "italic": true
    },
    "property": "#D7D9ED",
    "property.readonly": "#E0B684",
    "keyword": {
      "foreground": "#7AD1C9",
      "italic": true
    },
    "modifier": {
      "foreground": "#7AD1C9",
      "italic": true
    },
    "operator": "#9A9FE0",
    "comment": {
      "foreground": "#666A87",
      "italic": true
    },
    "string": "#9EE0C5",
    "number": "#E0B684",
    "regexp": "#EDA398",
    "decorator": {
      "foreground": "#7AD1C9",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Tier 4 — Recessed Context: Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#666A87",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 4 — Structural Punctuation (Dimmed to reduce eye noise)",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8589A6"
      }
    },
    {
      "name": "Tier 1 — Execution Hotspots: Function & Method Declarations/Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#AEB3F0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 1 — Control Flow & Keywords (High-Velocity Italic)",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#7AD1C9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 1 — Operators & Assignment Arrows",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#9A9FE0"
      }
    },
    {
      "name": "Tier 2 — Architecture & Types: Classes, Interfaces, Generics",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#C79BF2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 2 — Data Payloads: Strings & Template Literals",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#9EE0C5"
      }
    },
    {
      "name": "Tier 2 — Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#EDA398"
      }
    },
    {
      "name": "Tier 2 — String Interpolation Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#9A9FE0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 2 — Immutable Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E0B684"
      }
    },
    {
      "name": "Tier 3 — Variables & Identifiers (Pure High-Contrast Legibility)",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E9EAF7"
      }
    },
    {
      "name": "Tier 3 — Function Parameters & Arguments",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#EDA398",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 3 — Object Keys & Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D7D9ED"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML / XML Tags & Components",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#C79BF2"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML Attributes & Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#EDA398",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / This / Super Reference Keywords",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#7AD1C9",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown Headings & Documentation Architecture",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#AEB3F0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#7AD1C9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#9EE0C5"
      }
    },
    {
      "name": "Invalid & Deprecated Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E88296",
        "fontStyle": "underline"
      }
    }
  ]
}
