    "terminal.background": "#080911",
    "terminal.foreground": "#E9EAF7",
    "terminalCursor.foreground": "#8184F8",
    "terminal.selectionBackground": "#6366F133",
    "terminal.ansiBlack": "#141626",
    "terminal.ansiRed": "#E88296",
    "terminal.ansiGreen": "#7CE3B8",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#8184F8",
    "terminal.ansiMagenta": "#C79BF2",
    "terminal.ansiCyan": "#7AD1C9",
    "terminal.ansiWhite": "#E9EAF7",
    "terminal.ansiBrightBlack": "#767A99",
    "terminal.ansiBrightRed": "#F59DAE",
    "terminal.ansiBrightGreen": "#9EF0CD",
    "terminal.ansiBrightYellow": "#F2D49B",
    "terminal.ansiBrightBlue": "#A3A6FF",
    "terminal.ansiBrightMagenta": "#DAB8FA",
    "terminal.ansiBrightCyan": "#9CE3DC",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "statusBar.background": "#080911",
    "statusBar.foreground": "#9296B4",
    "statusBar.border": "#141626",
    "statusBar.debuggingBackground": "#6366F1",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#080911",
    "statusBarItem.remoteBackground": "#9A9FE0",
    "statusBarItem.remoteForeground": "#0C0D18",
