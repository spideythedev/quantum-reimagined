    "breadcrumb.background": "#0C0D18",
    "breadcrumb.foreground": "#767A99",
    "breadcrumb.focusForeground": "#E9EAF7",
    "breadcrumb.activeSelectionForeground": "#8184F8",
    "breadcrumbPicker.background": "#141626"
