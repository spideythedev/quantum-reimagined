  "semanticTokenColors": {
    "namespace": "#F472B6",
    "class": {
      "foreground": "#F472B6",
      "bold": true
    },
    "interface": {
      "foreground": "#F472B6",
      "italic": true
    },
    "enum": "#F472B6",
    "enumMember": "#FBBF24",
    "type": {
      "foreground": "#F472B6",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#00F5D4",
      "italic": true
    },
    "function": {
      "foreground": "#6366F1",
      "bold": true
    },
    "function.async": {
      "foreground": "#6366F1",
      "bold": true,
      "italic": true
    },
    "method": {
      "foreground": "#6366F1",
      "bold": true
    },
    "method.async": {
      "foreground": "#6366F1",
      "bold": true,
      "italic": true
    },
    "macro": {
      "foreground": "#00F5D4",
      "bold": true
    },
    "variable": "#F0F2FF",
    "variable.readonly": "#FBBF24",
    "variable.defaultLibrary": {
      "foreground": "#F472B6",
      "italic": true
    },
    "parameter": {
      "foreground": "#858BB8",
      "italic": true
    },
    "property": "#F0F2FF",
    "property.readonly": "#FBBF24",
    "keyword": {
      "foreground": "#00F5D4",
      "italic": true
    },
    "modifier": {
      "foreground": "#00F5D4",
      "italic": true
    },
    "operator": "#6366F1",
    "comment": {
      "foreground": "#42466B",
      "italic": true
    },
    "string": "#A5B4FC",
    "number": "#FBBF24",
    "regexp": "#00F5D4",
    "decorator": {
      "foreground": "#38BDF8",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Tier 4 \u2014 Recessed Context: Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#42466B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 4 \u2014 Structural Punctuation (Dimmed to reduce eye noise)",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#858BB8"
      }
    },
    {
      "name": "Tier 1 \u2014 Execution Hotspots: Function & Method Declarations/Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#6366F1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 1 \u2014 Control Flow & Keywords (High-Velocity Italic)",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#00F5D4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 1 \u2014 Operators & Assignment Arrows",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#6366F1"
      }
    },
    {
      "name": "Tier 2 \u2014 Architecture & Types: Classes, Interfaces, Generics",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#F472B6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 2 \u2014 Data Payloads: Strings & Template Literals",
      "scope": [
        "string",
        "constant.other.symbol",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A5B4FC"
      }
    },
    {
      "name": "Tier 2 \u2014 String Interpolation Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#6366F1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 2 \u2014 Immutable Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FBBF24"
      }
    },
    {
      "name": "Tier 3 \u2014 Variables & Identifiers (Pure High-Contrast Legibility)",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F0F2FF"
      }
    },
    {
      "name": "Tier 3 \u2014 Function Parameters & Arguments",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#858BB8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 3 \u2014 Object Keys & Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#F0F2FF"
      }
    },
    {
      "name": "Tier 2 \u2014 JSX / HTML / XML Tags & Components",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Tier 2 \u2014 JSX / HTML Attributes & Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#F472B6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / This / Super Reference Keywords",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#00F5D4",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown Headings & Documentation Architecture",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#6366F1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#00F5D4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#A5B4FC"
      }
    },
    {
      "name": "Invalid & Deprecated Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F43F5E",
        "fontStyle": "underline"
      }
    }
  ]
}