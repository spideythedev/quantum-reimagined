  "semanticTokenColors": {
    "namespace": "#C7A78D",
    "class": {
      "foreground": "#C7A78D",
      "bold": true
    },
    "interface": {
      "foreground": "#C7A78D",
      "italic": true
    },
    "enum": "#C7A78D",
    "enumMember": "#D88F79",
    "type": {
      "foreground": "#C7A78D",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#B6B0A0",
      "italic": true
    },
    "function": {
      "foreground": "#E4A27D",
      "bold": true
    },
    "function.async": {
      "foreground": "#E4A27D",
      "bold": true,
      "italic": true
    },
    "method": {
      "foreground": "#E4A27D",
      "bold": true
    },
    "method.async": {
      "foreground": "#E4A27D",
      "bold": true,
      "italic": true
    },
    "macro": {
      "foreground": "#D18A65",
      "bold": true
    },
    "variable": "#F2EAE4",
    "variable.readonly": "#D88F79",
    "variable.defaultLibrary": {
      "foreground": "#C7A78D",
      "italic": true
    },
    "parameter": {
      "foreground": "#B6B0A0",
      "italic": true
    },
    "property": "#F2EAE4",
    "property.readonly": "#D88F79",
    "keyword": {
      "foreground": "#D18A65",
      "italic": true
    },
    "modifier": {
      "foreground": "#D18A65",
      "italic": true
    },
    "operator": "#D99A70",
    "comment": {
      "foreground": "#927D70",
      "italic": true
    },
    "string": "#D9C18F",
    "number": "#D88F79",
    "regexp": "#B6B0A0",
    "decorator": {
      "foreground": "#C7A78D",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Tier 4 — Recessed Context: Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#927D70",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 4 — Structural Punctuation (Dimmed to reduce eye noise)",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#B9A18F"
      }
    },
    {
      "name": "Tier 1 — Execution Hotspots: Function & Method Declarations/Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#E4A27D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 1 — Control Flow & Keywords (High-Velocity Italic)",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#D18A65",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 1 — Operators & Assignment Arrows",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#D99A70"
      }
    },
    {
      "name": "Tier 2 — Architecture & Types: Classes, Interfaces, Generics",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#C7A78D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 2 — Data Payloads: Strings & Template Literals",
      "scope": [
        "string",
        "constant.other.symbol",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#D9C18F"
      }
    },
    {
      "name": "Tier 2 — String Interpolation Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#D99A70",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 2 — Immutable Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#D88F79"
      }
    },
    {
      "name": "Tier 3 — Variables & Identifiers (Pure High-Contrast Legibility)",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F2EAE4"
      }
    },
    {
      "name": "Tier 3 — Function Parameters & Arguments",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#B6B0A0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 3 — Object Keys & Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#F2EAE4"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML / XML Tags & Components",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#C7A78D"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML Attributes & Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#B6B0A0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / This / Super Reference Keywords",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#D18A65",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown Headings & Documentation Architecture",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#E4A27D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D18A65",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#D9C18F"
      }
    },
    {
      "name": "Invalid & Deprecated Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#D87970",
        "fontStyle": "underline"
      }
    }
  ]
}
