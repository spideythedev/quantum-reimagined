  "semanticTokenColors": {
    "namespace": "#C084FC",
    "class": {
      "foreground": "#C084FC",
      "bold": true
    },
    "interface": {
      "foreground": "#C084FC",
      "italic": true
    },
    "enum": "#C084FC",
    "enumMember": "#FB7185",
    "type": {
      "foreground": "#C084FC",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#38BDF8",
      "italic": true
    },
    "function": {
      "foreground": "#7DF9FF",
      "bold": true
    },
    "function.async": {
      "foreground": "#7DF9FF",
      "bold": true,
      "italic": true
    },
    "method": {
      "foreground": "#7DF9FF",
      "bold": true
    },
    "method.async": {
      "foreground": "#7DF9FF",
      "bold": true,
      "italic": true
    },
    "macro": {
      "foreground": "#38BDF8",
      "bold": true
    },
    "variable": "#F0FAFF",
    "variable.readonly": "#FB7185",
    "variable.defaultLibrary": {
      "foreground": "#C084FC",
      "italic": true
    },
    "parameter": {
      "foreground": "#82A0B0",
      "italic": true
    },
    "property": "#F0FAFF",
    "property.readonly": "#FB7185",
    "keyword": {
      "foreground": "#38BDF8",
      "italic": true
    },
    "modifier": {
      "foreground": "#38BDF8",
      "italic": true
    },
    "operator": "#7DF9FF",
    "comment": {
      "foreground": "#3F5561",
      "italic": true
    },
    "string": "#A5F3FC",
    "number": "#FB7185",
    "regexp": "#38BDF8",
    "decorator": {
      "foreground": "#60A5FA",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Tier 4 \u2014 Recessed Context: Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#3F5561",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 4 \u2014 Structural Punctuation (Dimmed to reduce eye noise)",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#82A0B0"
      }
    },
    {
      "name": "Tier 1 \u2014 Execution Hotspots: Function & Method Declarations/Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7DF9FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 1 \u2014 Control Flow & Keywords (High-Velocity Italic)",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 1 \u2014 Operators & Assignment Arrows",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#7DF9FF"
      }
    },
    {
      "name": "Tier 2 \u2014 Architecture & Types: Classes, Interfaces, Generics",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 2 \u2014 Data Payloads: Strings & Template Literals",
      "scope": [
        "string",
        "constant.other.symbol",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A5F3FC"
      }
    },
    {
      "name": "Tier 2 \u2014 String Interpolation Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7DF9FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 2 \u2014 Immutable Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FB7185"
      }
    },
    {
      "name": "Tier 3 \u2014 Variables & Identifiers (Pure High-Contrast Legibility)",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F0FAFF"
      }
    },
    {
      "name": "Tier 3 \u2014 Function Parameters & Arguments",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#82A0B0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 3 \u2014 Object Keys & Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#F0FAFF"
      }
    },
    {
      "name": "Tier 2 \u2014 JSX / HTML / XML Tags & Components",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#60A5FA"
      }
    },
    {
      "name": "Tier 2 \u2014 JSX / HTML Attributes & Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / This / Super Reference Keywords",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown Headings & Documentation Architecture",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#7DF9FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#A5F3FC"
      }
    },
    {
      "name": "Invalid & Deprecated Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F87171",
        "fontStyle": "underline"
      }
    }
  ]
}