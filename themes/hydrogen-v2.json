  "semanticTokenColors": {
    "namespace": "#9FB8E8",
    "class": {
      "foreground": "#9FB8E8",
      "bold": true
    },
    "interface": {
      "foreground": "#9FB8E8",
      "italic": true
    },
    "enum": "#9FB8E8",
    "enumMember": "#E0B979",
    "type": {
      "foreground": "#9FB8E8",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#B8CDF2",
      "italic": true
    },
    "function": {
      "foreground": "#7CE8E0",
      "bold": true
    },
    "function.async": {
      "foreground": "#7CE8E0",
      "bold": true,
      "italic": true
    },
    "method": {
      "foreground": "#7CE8E0",
      "bold": true
    },
    "method.async": {
      "foreground": "#7CE8E0",
      "bold": true,
      "italic": true
    },
    "macro": {
      "foreground": "#6BB8FF",
      "bold": true
    },
    "variable": "#E7F1F3",
    "variable.readonly": "#E0B979",
    "variable.defaultLibrary": {
      "foreground": "#9FB8E8",
      "italic": true
    },
    "parameter": {
      "foreground": "#EDA398",
      "italic": true
    },
    "property": "#D4E3E6",
    "property.readonly": "#E0B979",
    "keyword": {
      "foreground": "#6BB8FF",
      "italic": true
    },
    "modifier": {
      "foreground": "#6BB8FF",
      "italic": true
    },
    "operator": "#83C8C0",
    "comment": {
      "foreground": "#5B7075",
      "italic": true
    },
    "string": "#9EE3BD",
    "number": "#E0B979",
    "regexp": "#EDA398",
    "decorator": {
      "foreground": "#6BB8FF",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Tier 4 — Recessed Context: Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#5B7075",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 4 — Structural Punctuation (Dimmed to reduce eye noise)",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#7C9399"
      }
    },
    {
      "name": "Tier 1 — Execution Hotspots: Function & Method Declarations/Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7CE8E0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 1 — Control Flow & Keywords (High-Velocity Italic)",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#6BB8FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 1 — Operators & Assignment Arrows",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#83C8C0"
      }
    },
    {
      "name": "Tier 2 — Architecture & Types: Classes, Interfaces, Generics",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#9FB8E8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 2 — Data Payloads: Strings & Template Literals",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#9EE3BD"
      }
    },
    {
      "name": "Tier 2 — Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#EDA398"
      }
    },
    {
      "name": "Tier 2 — String Interpolation Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#83C8C0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 2 — Immutable Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E0B979"
      }
    },
    {
      "name": "Tier 3 — Variables & Identifiers (Pure High-Contrast Legibility)",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E7F1F3"
      }
    },
    {
      "name": "Tier 3 — Function Parameters & Arguments",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#EDA398",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 3 — Object Keys & Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D4E3E6"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML / XML Tags & Components",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#9FB8E8"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML Attributes & Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#EDA398",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / This / Super Reference Keywords",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#6BB8FF",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown Headings & Documentation Architecture",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#7CE8E0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#6BB8FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#9EE3BD"
      }
    },
    {
      "name": "Invalid & Deprecated Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E88282",
        "fontStyle": "underline"
      }
    }
  ]
}
