  "semanticTokenColors": {
    "namespace": "#A8B8D8",
    "class": {
      "foreground": "#A8B8D8",
      "bold": true
    },
    "interface": {
      "foreground": "#A8B8D8",
      "italic": true
    },
    "enum": "#A8B8D8",
    "enumMember": "#D5B69A",
    "type": {
      "foreground": "#A8B8D8",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#A4C7D1",
      "italic": true
    },
    "function": {
      "foreground": "#8DD8CF",
      "bold": true
    },
    "function.async": {
      "foreground": "#8DD8CF",
      "bold": true,
      "italic": true
    },
    "method": {
      "foreground": "#8DD8CF",
      "bold": true
    },
    "method.async": {
      "foreground": "#8DD8CF",
      "bold": true,
      "italic": true
    },
    "macro": {
      "foreground": "#80B8C4",
      "bold": true
    },
    "variable": "#E7F1F3",
    "variable.readonly": "#D5B69A",
    "variable.defaultLibrary": {
      "foreground": "#A8B8D8",
      "italic": true
    },
    "parameter": {
      "foreground": "#A4C7D1",
      "italic": true
    },
    "property": "#E7F1F3",
    "property.readonly": "#D5B69A",
    "keyword": {
      "foreground": "#80B8C4",
      "italic": true
    },
    "modifier": {
      "foreground": "#80B8C4",
      "italic": true
    },
    "operator": "#83C8C0",
    "comment": {
      "foreground": "#71898D",
      "italic": true
    },
    "string": "#B5D5B2",
    "number": "#D5B69A",
    "regexp": "#A4C7D1",
    "decorator": {
      "foreground": "#A8B8D8",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Tier 4 — Recessed Context: Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#71898D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 4 — Structural Punctuation (Dimmed to reduce eye noise)",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9BB1B3"
      }
    },
    {
      "name": "Tier 1 — Execution Hotspots: Function & Method Declarations/Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8DD8CF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 1 — Control Flow & Keywords (High-Velocity Italic)",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#80B8C4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 1 — Operators & Assignment Arrows",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#83C8C0"
      }
    },
    {
      "name": "Tier 2 — Architecture & Types: Classes, Interfaces, Generics",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#A8B8D8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 2 — Data Payloads: Strings & Template Literals",
      "scope": [
        "string",
        "constant.other.symbol",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#B5D5B2"
      }
    },
    {
      "name": "Tier 2 — String Interpolation Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#83C8C0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 2 — Immutable Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#D5B69A"
      }
    },
    {
      "name": "Tier 3 — Variables & Identifiers (Pure High-Contrast Legibility)",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E7F1F3"
      }
    },
    {
      "name": "Tier 3 — Function Parameters & Arguments",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#A4C7D1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 3 — Object Keys & Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E7F1F3"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML / XML Tags & Components",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#A8B8D8"
      }
    },
    {
      "name": "Tier 2 — JSX / HTML Attributes & Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#A4C7D1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / This / Super Reference Keywords",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#80B8C4",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown Headings & Documentation Architecture",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#8DD8CF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#80B8C4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#B5D5B2"
      }
    },
    {
      "name": "Invalid & Deprecated Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#D98989",
        "fontStyle": "underline"
      }
    }
  ]
}
