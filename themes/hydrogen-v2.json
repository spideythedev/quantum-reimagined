    "terminal.background": "#050A0E",
    "terminal.foreground": "#E7F1F3",
    "terminalCursor.foreground": "#6CE8EE",
    "terminal.selectionBackground": "#7DF9FF2E",
    "terminal.ansiBlack": "#101E26",
    "terminal.ansiRed": "#E88282",
    "terminal.ansiGreen": "#7CE3B3",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#6BB8FF",
    "terminal.ansiMagenta": "#C59CE8",
    "terminal.ansiCyan": "#7CE8E0",
    "terminal.ansiWhite": "#E7F1F3",
    "terminal.ansiBrightBlack": "#6B8287",
    "terminal.ansiBrightRed": "#F59C9C",
    "terminal.ansiBrightGreen": "#9FF0C8",
    "terminal.ansiBrightYellow": "#F2D49B",
    "terminal.ansiBrightBlue": "#8FC9FF",
    "terminal.ansiBrightMagenta": "#D9B8F5",
    "terminal.ansiBrightCyan": "#9EF2EC",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "statusBar.background": "#050A0E",
    "statusBar.foreground": "#879DA2",
    "statusBar.border": "#101E26",
    "statusBar.debuggingBackground": "#7DF9FF",
    "statusBar.debuggingForeground": "#050A0E",
    "statusBar.noFolderBackground": "#050A0E",
    "statusBarItem.remoteBackground": "#83C8C0",
    "statusBarItem.remoteForeground": "#050A0E",
    "statusBarItem.hoverBackground": "#15262F",

    "titleBar.activeBackground": "#050A0E",
    "titleBar.activeForeground": "#879DA2",
    "titleBar.inactiveBackground": "#050A0E",
    "titleBar.inactiveForeground": "#52666B",
    "titleBar.border": "#050A0E",

    "commandCenter.foreground": "#879DA2",
    "commandCenter.activeForeground": "#E7F1F3",
    "commandCenter.background": "#0F1D24",
    "commandCenter.activeBackground": "#15262F",
    "commandCenter.border": "#1A2E38",

    "breadcrumb.background": "#091116",
    "breadcrumb.foreground": "#6B8287",
    "breadcrumb.focusForeground": "#E7F1F3",
    "breadcrumb.activeSelectionForeground": "#6CE8EE",
    "breadcrumbPicker.background": "#101E26"
