  "semanticTokenColors": {
    "namespace": "#00E5FF",
    "class": {
      "foreground": "#00E5FF",
      "bold": true
    },
    "interface": {
      "foreground": "#00E5FF",
      "italic": true
    },
    "enum": "#00E5FF",
    "enumMember": "#FF7733",
    "type": {
      "foreground": "#00E5FF",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#FF3366",
      "italic": true
    },
    "function": {
      "foreground": "#FFB800",
      "bold": true
    },
    "function.async": {
      "foreground": "#FFB800",
      "bold": true,
      "italic": true
    },
    "method": {
      "foreground": "#FFB800",
      "bold": true
    },
    "method.async": {
      "foreground": "#FFB800",
      "bold": true,
      "italic": true
    },
    "macro": {
      "foreground": "#FF3366",
      "bold": true
    },
    "variable": "#F5F2FA",
    "variable.readonly": "#FF7733",
    "variable.defaultLibrary": {
      "foreground": "#00E5FF",
      "italic": true
    },
    "parameter": {
      "foreground": "#948BA6",
      "italic": true
    },
    "property": "#F5F2FA",
    "property.readonly": "#FF7733",
    "keyword": {
      "foreground": "#FF3366",
      "italic": true
    },
    "modifier": {
      "foreground": "#FF3366",
      "italic": true
    },
    "operator": "#FFB800",
    "comment": {
      "foreground": "#4D4461",
      "italic": true
    },
    "string": "#FFE066",
    "number": "#FF7733",
    "regexp": "#FF3366",
    "decorator": {
      "foreground": "#B366FF",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Tier 4 \u2014 Recessed Context: Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#4D4461",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 4 \u2014 Structural Punctuation (Dimmed to reduce eye noise)",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#948BA6"
      }
    },
    {
      "name": "Tier 1 \u2014 Execution Hotspots: Function & Method Declarations/Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#FFB800",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 1 \u2014 Control Flow & Keywords (High-Velocity Italic)",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#FF3366",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 1 \u2014 Operators & Assignment Arrows",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#FFB800"
      }
    },
    {
      "name": "Tier 2 \u2014 Architecture & Types: Classes, Interfaces, Generics",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#00E5FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 2 \u2014 Data Payloads: Strings & Template Literals",
      "scope": [
        "string",
        "constant.other.symbol",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#FFE066"
      }
    },
    {
      "name": "Tier 2 \u2014 String Interpolation Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#FFB800",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tier 2 \u2014 Immutable Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FF7733"
      }
    },
    {
      "name": "Tier 3 \u2014 Variables & Identifiers (Pure High-Contrast Legibility)",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F5F2FA"
      }
    },
    {
      "name": "Tier 3 \u2014 Function Parameters & Arguments",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#948BA6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tier 3 \u2014 Object Keys & Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#F5F2FA"
      }
    },
    {
      "name": "Tier 2 \u2014 JSX / HTML / XML Tags & Components",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#B366FF"
      }
    },
    {
      "name": "Tier 2 \u2014 JSX / HTML Attributes & Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#00E5FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / This / Super Reference Keywords",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#FF3366",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown Headings & Documentation Architecture",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#FFB800",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FF3366",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#FFE066"
      }
    },
    {
      "name": "Invalid & Deprecated Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF2A55",
        "fontStyle": "underline"
      }
    }
  ]
}